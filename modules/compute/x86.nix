{ config, self, ... }:
{
  compute.x86 = {
    supportedDisks = [ "nvme" ]; # Physical disks only; virtual device types use a `virtual` disk
    requiresFacter = true; # Include hardware configuration generated by `nixos-facter` (waived for virtual devices)
    supportsVirtual = true;
    module = config.flake.modules.nixos.compute-x86;
  };

  flake.modules.nixos.compute-x86 =
    { modulesPath, ... }:
    {
      imports = [
        self.modules.nixos.storage-layout # Defines storage.device and storage.bootPartitions
        (modulesPath + "/installer/scan/not-detected.nix") # Sets hardware.enableRedistributableFirmware = true
      ];

      nixpkgs.hostPlatform = "x86_64-linux";

      # Configure GRUB bootloader
      boot.loader.grub = {
        efiSupport = true;
        efiInstallAsRemovable = true;
        devices = [ "nodev" ];
      };

      # Configure boot partition
      storage.bootPartitions.esp = {
        name = "ESP";
        size = "500M";
        type = "EF00";
        content = {
          type = "filesystem";
          format = "vfat";
          mountpoint = "/boot";
          mountOptions = [ "umask=0077" ];
        };
      };
    };
}
